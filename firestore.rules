// ============================================================================
// FIRESTORE SECURITY RULES — Portal Kelas TM-1
//
// CARA PASANG:
// 1. Buka console.firebase.google.com > project kamu > Firestore Database > tab "Rules"
// 2. Hapus semua isi kotak rules yang lama
// 3. Copy-paste SELURUH isi file ini ke kotak tersebut
// 4. Klik "Publish"
//
// Rules ini adalah PENEGAKAN ASLI di server Firebase — bukan sekadar kode
// JS di browser. Siapapun yang mencoba akses lewat cara lain (API langsung,
// console browser, dsb) tetap akan ditolak Firebase kalau melanggar aturan
// di bawah ini.
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: cek apakah user yang sedang login adalah admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ------------------------------------------------------------------
    // COLLECTION "users" — profil, role, status, permission tiap akun
    // ------------------------------------------------------------------
    match /users/{userId} {
      // Baca profil: pemilik akun sendiri, ATAU admin (untuk Admin Panel)
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Bikin akun baru (signup): boleh dilakukan oleh 2 pihak —
      // 1) ADMIN, lewat Admin Panel, boleh bikin dokumen untuk UID
      //    siapa saja (siswa baru) dengan role apa saja.
      // 2) Orang itu sendiri, HANYA boleh bikin dokumen ID = uid sendiri,
      //    dan WAJIB role "siswa" — tidak ada yang bisa daftar sebagai
      //    admin dari form signup biasa.
      allow create: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.role == 'siswa')
      );

      // Ubah profil: pemilik akun boleh ubah data dirinya (nama, dsb) TAPI
      // TIDAK BOLEH mengubah role/status/permissions miliknya sendiri —
      // itu mencegah siswa menaikkan hak aksesnya sendiri lewat request
      // palsu. Admin boleh mengubah field apa saja untuk siapa saja.
      //
      // Field "chess" dan "uno" (rating/poin/riwayat game) TIDAK termasuk
      // update profil biasa ini — itu diatur khusus oleh isValidChessStatUpdate()
      // dan isValidUnoStatUpdate() di bawah, supaya siswa tidak bisa
      // mengetik rating berapapun lewat form edit profil biasa.
      allow update: if request.auth != null && (
        isAdmin() ||
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.permissions == resource.data.permissions &&
          (isValidChessStatUpdate(userId) || request.resource.data.chess == resource.data.chess) &&
          (isValidUnoStatUpdate(userId) || request.resource.data.uno == resource.data.uno))
      );

      // Hapus akun: hanya admin.
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // ANTI-CHEAT (versi Firestore Rules — tanpa Cloud Functions):
    // Website ini statis (tidak ada server backend), jadi rating/poin
    // TIDAK BISA divalidasi 100% seperti platform besar (yang pakai
    // Cloud Functions). Yang bisa dilakukan di sini: BATASI seberapa
    // besar rating/poin bisa berubah dalam satu kali simpan, dan wajibkan
    // angka "games" naik konsisten dengan naik "wins/draws/losses".
    // Ini mencegah user iseng ketik rating 9999 lewat console browser,
    // tapi tidak 100% mustahil dicurangi oleh user yang sangat niat.
    // Untuk kelas sekolah, ini levelnya sudah cukup wajar.
    // ------------------------------------------------------------------
    function chessOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.chess;
    }
    function unoOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.uno;
    }

    function isValidChessStatUpdate(userId) {
      let before = chessOf(userId);
      let after = request.resource.data.chess;
      // rating tidak boleh melompat lebih dari 40 poin (K-factor ELO standar) sekali simpan
      let ratingDelta = after.rating - before.rating;
      // games harus naik tepat 1, dan TEPAT SATU dari wins/draws/losses yang naik 1
      let gamesNaik = after.games == before.games + 1;
      let winNaik = after.wins == before.wins + 1;
      let drawNaik = after.draws == before.draws + 1;
      let lossNaik = after.losses == before.losses + 1;
      let winSama = after.wins == before.wins;
      let drawSama = after.draws == before.draws;
      let lossSama = after.losses == before.losses;
      let tepatSatuHasil =
        (winNaik && drawSama && lossSama) ||
        (drawNaik && winSama && lossSama) ||
        (lossNaik && winSama && drawSama);
      return gamesNaik && tepatSatuHasil && ratingDelta <= 40 && ratingDelta >= -40 && after.rating >= 100;
    }

    function isValidUnoStatUpdate(userId) {
      let before = unoOf(userId);
      let after = request.resource.data.uno;
      let pointsDelta = after.points - before.points;
      let gamesNaik = after.games == before.games + 1;
      // poin per game cuma boleh +10 (menang), +5 (peringkat 2/3), atau -10 (kalah/peringkat bawah)
      let poinValid = pointsDelta == 10 || pointsDelta == 5 || pointsDelta == -10;
      let winValid = after.wins == before.wins || after.wins == before.wins + 1;
      let podiumValid = after.podium == before.podium || after.podium == before.podium + 1;
      return gamesNaik && poinValid && winValid && podiumValid;
    }

    // ------------------------------------------------------------------
    // COLLECTION "chessMatches" — riwayat/audit tiap pertandingan catur.
    // Dibuat SEKALI oleh salah satu pemain setelah game selesai, tidak
    // bisa diubah/dihapus lagi (immutable) supaya jadi jejak yang jujur.
    // ------------------------------------------------------------------
    match /chessMatches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.player1Id ||
         request.auth.uid == request.resource.data.player2Id) &&
        request.resource.data.ratingChange.player1 <= 40 && request.resource.data.ratingChange.player1 >= -40 &&
        request.resource.data.ratingChange.player2 <= 40 && request.resource.data.ratingChange.player2 >= -40;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // COLLECTION "unoMatches" — riwayat/audit tiap pertandingan UNO.
    // ------------------------------------------------------------------
    match /unoMatches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.playerIds;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // COLLECTION "chessRooms" / "unoRooms" — state permainan real-time
    // (lobby, giliran, papan/kartu saat ini).
    //
    // ATURAN AKSES:
    // - Room berstatus "waiting" (masih menunggu 1 slot lagi) BOLEH dibaca
    //   siapa saja yang sudah login — ini disengaja, supaya fitur "Quick
    //   Match" bisa mencari room kosong milik orang lain, dan "Kode Room"
    //   bisa dicari lewat query roomCode. Begitu room penuh (status jadi
    //   "playing"), hanya kedua pemain di dalamnya yang boleh baca/tulis.
    // - JOIN (mengisi slot kosong): siapapun yang BUKAN pembuat room boleh
    //   melakukan SATU transisi spesifik: playerIds bertambah dari 1 jadi 2
    //   (uid lama tetap di posisi awal, uid baru ditambahkan), dan status
    //   berubah dari "waiting" ke "playing". Selain transisi persis ini,
    //   ditolak.
    // - Setelah room "playing", HANYA kedua pemain di dalamnya yang boleh
    //   update (kirim langkah, resign, tandai selesai).
    // - Room "waiting" boleh dihapus HANYA oleh pembuatnya sendiri (untuk
    //   tombol "Batal" saat menunggu lawan).
    // ------------------------------------------------------------------
    function tmRoomJoinTransitionValid() {
      return resource.data.status == 'waiting'
        && resource.data.playerIds.size() == 1
        && !(request.auth.uid in resource.data.playerIds)
        && request.resource.data.playerIds.size() == 2
        && request.resource.data.playerIds[0] == resource.data.playerIds[0]
        && request.resource.data.playerIds[1] == request.auth.uid
        && request.resource.data.status == 'playing';
    }

    match /chessRooms/{roomId} {
      // Turn dihitung dari jumlah langkah tersimpan: genap = giliran putih, ganjil = giliran hitam.
      // Ini membuat giliran TIDAK BISA dipalsukan dari client — dihitung ulang dari data server sendiri.
      function tmCurrentTurnUid() {
        let n = resource.data.moves.size();
        let turnColor = n % 2 == 0 ? 'w' : 'b';
        return resource.data.colors[turnColor];
      }
      // Hanya boleh MENAMBAH satu langkah di akhir array, oleh uid yang memang gilirannya,
      // sekalian update clock (turnStartedAt/clockRemaining) — tidak boleh nyelundup ubah
      // field lain (status/hasil/dsb lewat jalur ini).
      function tmChessMoveValid() {
        let n = resource.data.moves.size();
        let turnColor = n % 2 == 0 ? 'w' : 'b';
        let oppColor = turnColor == 'w' ? 'b' : 'w';
        let inc = resource.data.timeControl.inc;
        let beforeClock = resource.data.clockRemaining;
        let afterClock = request.resource.data.clockRemaining;
        return resource.data.status == 'playing'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['moves', 'updatedAt', 'clockRemaining', 'turnStartedAt'])
          && request.resource.data.moves.size() == n + 1
          && request.auth.uid == tmCurrentTurnUid()
          // clock lawan (yang TIDAK jalan gilirannya) tidak boleh ikut berubah
          && afterClock[oppColor] == beforeClock[oppColor]
          // clock milik sendiri cuma boleh berkurang (dia mikir) lalu ditambah increment —
          // tidak boleh digelembungkan lebih dari before + increment (anti "nambah waktu sendiri")
          && afterClock[turnColor] <= beforeClock[turnColor] + inc
          && afterClock[turnColor] >= 0;
      }
      allow read: if request.auth != null &&
        (resource.data.status == 'waiting' || request.auth.uid in resource.data.playerIds);
      allow create: if request.auth != null &&
        request.resource.data.playerIds.size() == 1 &&
        request.resource.data.playerIds[0] == request.auth.uid &&
        request.resource.data.status == 'waiting';
      allow update: if request.auth != null && (
        tmRoomJoinTransitionValid() ||
        tmChessMoveValid() ||
        (request.auth.uid in resource.data.playerIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'result', 'updatedAt']))
      );
      allow delete: if request.auth != null &&
        resource.data.status == 'waiting' && request.auth.uid in resource.data.playerIds;
    }

    match /unoRooms/{roomId} {
      function unoJoinValid() {
        return resource.data.status == 'lobby'
          && !(request.auth.uid in resource.data.playerIds)
          && resource.data.playerIds.size() < resource.data.maxPlayers
          && request.resource.data.playerIds.size() == resource.data.playerIds.size() + 1
          && request.resource.data.playerIds.hasAll(resource.data.playerIds)
          && request.auth.uid in request.resource.data.playerIds
          && request.resource.data.status == 'lobby';
      }
      function unoLeaveLobbyValid() {
        return resource.data.status == 'lobby'
          && request.auth.uid in resource.data.playerIds
          && request.resource.data.playerIds.size() == resource.data.playerIds.size() - 1
          && !(request.auth.uid in request.resource.data.playerIds)
          && resource.data.playerIds.hasAll(request.resource.data.playerIds);
      }
      function unoStartValid() {
        return resource.data.status == 'lobby'
          && request.auth.uid == resource.data.hostUid
          && resource.data.playerIds.size() >= 2
          && request.resource.data.status == 'playing';
      }
      function unoInGameTurnValid() {
        return resource.data.status == 'playing' && (
          request.auth.uid == resource.data.currentTurnUid ||
          (resource.data.pendingForceDraw != null && request.auth.uid == resource.data.pendingForceDraw.uid)
        );
      }
      // Pembagian kartu awal: begitu game dimulai, SETIAP pemain (bukan
      // cuma yang giliran pertama) perlu menulis "aku sudah dapat 7 kartu"
      // ke room doc untuk dirinya sendiri. Transisi ini SANGAT DIBATASI:
      // hanya field handCounts/drawPileCount/updatedAt yang boleh berubah,
      // dan di dalam handCounts hanya milik uid pemanggil sendiri, HARUS
      // tepat 7, dan HANYA kalau dia belum pernah deal sebelumnya.
      function unoDealSelfValid() {
        return resource.data.status == 'playing'
          && request.auth.uid in resource.data.playerIds
          && !(request.auth.uid in resource.data.handCounts)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handCounts', 'drawPileCount', 'updatedAt'])
          && request.resource.data.handCounts.diff(resource.data.handCounts).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.handCounts[request.auth.uid] == 7;
      }

      allow read: if request.auth != null &&
        (resource.data.status == 'lobby' || request.auth.uid in resource.data.playerIds);
      allow create: if request.auth != null &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.playerIds.size() == 1 &&
        request.resource.data.playerIds[0] == request.auth.uid &&
        request.resource.data.status == 'lobby';
      allow update: if request.auth != null &&
        (unoJoinValid() || unoLeaveLobbyValid() || unoStartValid() || unoDealSelfValid() || unoInGameTurnValid());
      allow delete: if request.auth != null &&
        resource.data.status == 'lobby' && request.auth.uid == resource.data.hostUid;
    }

    // "Tangan" (kartu) tiap pemain — SUBCOLLECTION TERPISAH per uid, supaya
    // pemain lain (yang juga bisa baca dokumen room utama) TIDAK BISA
    // membaca kartu orang lain. Hanya pemilik uid yang boleh baca/tulis
    // milik dirinya sendiri.
    match /unoRooms/{roomId}/hands/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Sisa dek kartu yang belum dibagikan. CATATAN JUJUR: karena tidak ada
    // server/Cloud Functions, dek ini harus bisa dibaca client yang sedang
    // menarik kartu — artinya urutan kartu yang tersisa SECARA TEKNIS bisa
    // dilihat pemain yang membuka console browser. Ini keterbatasan yang
    // tidak bisa dihindari tanpa backend sungguhan.
    match /unoRooms/{roomId}/deck/{docId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/unoRooms/$(roomId)).data.playerIds;
    }

    // ------------------------------------------------------------------
    // COLLECTION "dataSiswa" — fitur "Isi Data Saya".
    // DIKUNCI: sekarang wajib login (siswa/admin) untuk baca maupun
    // tulis data. Tamu (belum login) tidak bisa lagi mengubah data
    // telp/ig/piket siswa lain lewat form ini.
    // ------------------------------------------------------------------
    match /dataSiswa/{docId} {
      allow read, write: if request.auth != null;
    }

  }
}
